{
	"name": "shaped-kit",
	"version": "0.1.0",
	"private": true,
	"description": "Shaped Kit admin dashboard (React).",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build assets/admin/index.js --output-path=build/admin",
		"start": "wp-scripts start assets/admin/index.js --output-path=build/admin",
		"test:js": "wp-scripts test-unit-js --testMatch '**/assets/admin/**/*.test.js'",
		"format": "wp-scripts format assets/admin",
		"plugin-zip": "wp-scripts plugin-zip",
		"package:verify": "php tools/verify-package.php",
		"package": "npm run build && npm run plugin-zip && npm run package:verify"
	},
	"files": [
		"shaped-kit.php",
		"src",
		"libs",
		"build"
	],
	"devDependencies": {
		"@wordpress/scripts": "^30.25.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.30.0",
		"@wordpress/element": "^6.32.0",
		"@wordpress/i18n": "^6.30.0"
	}
}
