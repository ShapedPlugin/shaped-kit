<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/phpunit/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnRisky="true"
	failOnWarning="true"
>
	<testsuites>
		<!--
			unit        classes under src/ tested without WordPress. The
			            bootstrap registers the ShapedKit\ autoloader only; it
			            never includes shaped-kit.php, which needs WordPress.
			integration anything reaching WordPress (abilities, the MCP
			            server, REST routes, options). Needs the WordPress
			            test library; skips cleanly without it.
			            Select with SHAPED_KIT_PHPUNIT_BOOTSTRAP=integration.

			tests/unit/*.php are separate: dependency-free scripts that run
			the loader in fresh PHP processes (`composer test:scripts`).
		-->
		<testsuite name="unit">
			<directory>tests/phpunit/unit</directory>
		</testsuite>
		<testsuite name="integration">
			<directory>tests/phpunit/integration</directory>
		</testsuite>
		<!--
			integration-ci  the integration suite without the tests that load a sibling product plugin (Real
			                Testimonials, Location Weather) from next to the Kit. Those repos are private, so CI
			                cannot have them; the tests run locally with `composer test:integration`.
			                `composer test:integration:ci` also fails on any skipped test, so a missing
			                WordPress install or an unexpected skip fails the build instead of passing it.
			                A new test that needs a sibling goes in this list; one that does not is picked up
			                by the directory.
		-->
		<testsuite name="integration-ci">
			<directory>tests/phpunit/integration</directory>
			<exclude>tests/phpunit/integration/LocationWeatherWriteSlashesIntegrationTest.php</exclude>
			<exclude>tests/phpunit/integration/LocationWeatherWriteToolsIntegrationTest.php</exclude>
			<exclude>tests/phpunit/integration/RealTestimonialsBuilderToolsTestCase.php</exclude>
			<exclude>tests/phpunit/integration/RealTestimonialsBulkCreateIntegrationTest.php</exclude>
			<exclude>tests/phpunit/integration/RealTestimonialsConnectStateIntegrationTest.php</exclude>
			<exclude>tests/phpunit/integration/RealTestimonialsEmptyListsIntegrationTest.php</exclude>
			<exclude>tests/phpunit/integration/RealTestimonialsFreeBuilderToolsIntegrationTest.php</exclude>
			<exclude>tests/phpunit/integration/RealTestimonialsProBuilderToolsIntegrationTest.php</exclude>
			<exclude>tests/phpunit/integration/RealTestimonialsWriteSlashesIntegrationTest.php</exclude>
			<exclude>tests/phpunit/integration/RealTestimonialsWriteToolsIntegrationTest.php</exclude>
		</testsuite>
		<!--
			adapter-*   a product's real MCP server, run through one real adapter copy
			            (prompts and tools on the wire). Not part of `composer test`: it
			            needs SHAPED_KIT_PHPUNIT_BOOTSTRAP=adapter, and one process loads
			            one copy. `composer test:adapter` runs every product once per copy
			            found. One suite per product, because a product's tests must run
			            only against that product's profile (SHAPED_KIT_PRODUCT).
			            `adapter` is the default product (Real Testimonials).
			            `adapter-template` runs the product-module template itself, with
			            no sibling plugin, so it also runs where the sibling repos are absent.
		-->
		<testsuite name="adapter">
			<file>tests/phpunit/adapter/RealTestimonialsPromptsAdapterTest.php</file>
		</testsuite>
		<testsuite name="adapter-real-testimonials">
			<file>tests/phpunit/adapter/RealTestimonialsPromptsAdapterTest.php</file>
		</testsuite>
		<testsuite name="adapter-template">
			<file>tests/phpunit/adapter/TemplateAdapterTest.php</file>
		</testsuite>
	</testsuites>
</phpunit>
